<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="WinDotra — Wallpaper &amp; theme" Width="1100" Height="780" MinWidth="960" MinHeight="700" WindowStartupLocation="CenterScreen" Background="#1C1C1E" Foreground="#F5F5F7" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14">
 <Window.Resources>
  <!-- WinDotra's dark theme, after macOS System Settings: graphite surfaces, grouped panels, one blue accent. Studio and every overlay reuse this dictionary. -->
  <Style TargetType="Button"><Setter Property="Foreground" Value="#F5F5F7"/><Setter Property="Background" Value="#3A3A3C"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="14,7"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
   <Grid><Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"/><Border x:Name="H" Background="#FFFFFF" CornerRadius="8" Opacity="0"/><Border x:Name="F" CornerRadius="8" BorderBrush="#0A84FF" BorderThickness="0"/>
   <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Grid>
   <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="H" Property="Opacity" Value="0.07"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="H" Property="Opacity" Value="0.13"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="F" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#0A84FF"/><Setter Property="Foreground" Value="#FFFFFF"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style x:Key="Ghost" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#0A84FF"/></Style>
  <Style x:Key="Nav" TargetType="Button"><Setter Property="Foreground" Value="#E5E5EA"/><Setter Property="Background" Value="Transparent"/><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="Padding" Value="10,7"/><Setter Property="Margin" Value="0,1"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
   <Grid><Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="7"/><Border x:Name="F" CornerRadius="7" BorderBrush="#0A84FF" BorderThickness="0"/>
   <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Left" VerticalAlignment="Center"/></Grid>
   <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#2C2C2E"/></Trigger><Trigger Property="Tag" Value="active"><Setter TargetName="B" Property="Background" Value="#0A84FF"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="F" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#F5F5F7"/><Setter Property="Margin" Value="0,6,0,6"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
   <Grid Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Border x:Name="Box" Width="16" Height="16" CornerRadius="8" BorderThickness="1.5" BorderBrush="#8E8E93" Background="Transparent" VerticalAlignment="Top" Margin="0,2,10,0"><Path x:Name="Mark" Data="M3.5,8 L6.5,11 L12,4.5" Stroke="#FFFFFF" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Opacity="0" Margin="-1.5,-1.5,0,0"/></Border>
   <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/></Grid>
   <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#0A84FF"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="#0A84FF"/><Setter TargetName="Box" Property="BorderBrush" Value="#0A84FF"/><Setter TargetName="Mark" Property="Opacity" Value="1"/></Trigger></ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Switch" TargetType="CheckBox"><Setter Property="Foreground" Value="#F5F5F7"/><Setter Property="Margin" Value="0"/><Setter Property="Padding" Value="0,11"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
   <Grid Background="Transparent" Margin="{TemplateBinding Padding}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <ContentPresenter VerticalAlignment="Center" Margin="0,0,16,0"/>
   <Border x:Name="Track" Grid.Column="1" Width="38" Height="22" CornerRadius="11" Background="#48484A" VerticalAlignment="Center"><Ellipse x:Name="Knob" Width="18" Height="18" Fill="#FFFFFF" HorizontalAlignment="Left" Margin="2,0,2,0"><Ellipse.Effect><DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.35"/></Ellipse.Effect></Ellipse></Border></Grid>
   <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="#0A84FF"/><Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="#FFFFFF"/><Setter TargetName="Track" Property="BorderThickness" Value="1.5"/></Trigger></ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="SliderStep" TargetType="RepeatButton"><Setter Property="Focusable" Value="False"/><Setter Property="IsTabStop" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"><Border Background="{TemplateBinding Background}" Height="4" CornerRadius="2"/></Border></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="Slider"><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
   <Track x:Name="PART_Track" Height="22"><Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource SliderStep}" Background="#0A84FF" Command="Slider.DecreaseLarge"/></Track.DecreaseRepeatButton><Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource SliderStep}" Background="#48484A" Command="Slider.IncreaseLarge"/></Track.IncreaseRepeatButton>
   <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse x:Name="T" Width="20" Height="20" Fill="#FFFFFF"><Ellipse.Effect><DropShadowEffect BlurRadius="5" ShadowDepth="1" Opacity="0.4"/></Ellipse.Effect></Ellipse></ControlTemplate></Thumb.Template></Thumb></Track.Thumb></Track>
  </ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="ScrollThumb" TargetType="Thumb"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb"><Border x:Name="T" Background="#48484A" CornerRadius="3"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="T" Property="Background" Value="#636366"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="ScrollGap" TargetType="RepeatButton"><Setter Property="Focusable" Value="False"/><Setter Property="IsTabStop" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ScrollBar"><Setter Property="Width" Value="7"/><Setter Property="MinWidth" Value="7"/><Setter Property="MinHeight" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
   <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="0,4"><Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource ScrollGap}" Command="ScrollBar.PageUpCommand"/></Track.DecreaseRepeatButton><Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource ScrollGap}" Command="ScrollBar.PageDownCommand"/></Track.IncreaseRepeatButton><Track.Thumb><Thumb Style="{StaticResource ScrollThumb}"/></Track.Thumb></Track>
   </ControlTemplate></Setter.Value></Setter>
   <Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="MinWidth" Value="0"/><Setter Property="Height" Value="7"/><Setter Property="MinHeight" Value="7"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
    <Track x:Name="PART_Track" Margin="4,0"><Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource ScrollGap}" Command="ScrollBar.PageLeftCommand"/></Track.DecreaseRepeatButton><Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource ScrollGap}" Command="ScrollBar.PageRightCommand"/></Track.IncreaseRepeatButton><Track.Thumb><Thumb Style="{StaticResource ScrollThumb}"/></Track.Thumb></Track>
   </ControlTemplate></Setter.Value></Setter></Trigger></Style.Triggers></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#1C1C1E"/><Setter Property="Foreground" Value="#F5F5F7"/><Setter Property="CaretBrush" Value="#F5F5F7"/><Setter Property="SelectionBrush" Value="#0A84FF"/><Setter Property="BorderBrush" Value="#3A3A3C"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="10,7"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
   <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"><Grid><Border x:Name="Ring" CornerRadius="8" Margin="-1" BorderBrush="#0A84FF" BorderThickness="2" Opacity="0"/><ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"/></Grid></Border>
   <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Ring" Property="Opacity" Value="1"/></Trigger></ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ListBoxItem"><Setter Property="Foreground" Value="#F5F5F7"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
   <Border x:Name="B" Background="Transparent" CornerRadius="6" Margin="4,1" Padding="4,1"><ContentPresenter/></Border>
   <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#3A3A3C"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="B" Property="Background" Value="#0A84FF"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger></ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ListBox"><Setter Property="Background" Value="#1C1C1E"/><Setter Property="Foreground" Value="#F5F5F7"/><Setter Property="BorderBrush" Value="#3A3A3C"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBox">
   <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="0,4"><ScrollViewer Focusable="False"><ItemsPresenter/></ScrollViewer></Border>
  </ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#F5F5F7"/><Setter Property="Padding" Value="10,6"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
   <Border x:Name="B" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}" Margin="4,1"><ContentPresenter/></Border>
   <ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="B" Property="Background" Value="#0A84FF"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger></ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#F5F5F7"/><Setter Property="FontSize" Value="14"/><Setter Property="Margin" Value="0,6,0,14"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
   <Grid><ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="B" Background="#3A3A3C" CornerRadius="8"><Path Data="M0,0 L4.5,4.5 L9,0" Stroke="#AEAEB2" StrokeThickness="1.6" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#48484A"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template></ToggleButton>
   <ContentPresenter IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="12,7,34,7" VerticalAlignment="Center"/>
   <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"><Border Background="#2C2C2E" BorderBrush="#48484A" BorderThickness="1" CornerRadius="9" Margin="0,4,8,8" Padding="0,4" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}"><Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.45"/></Border.Effect><ScrollViewer><ItemsPresenter/></ScrollViewer></Border></Popup></Grid>
  </ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ToolTip"><Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/><Setter Property="Background" Value="#2C2C2E"/><Setter Property="Foreground" Value="#F5F5F7"/><Setter Property="BorderBrush" Value="#48484A"/><Setter Property="Padding" Value="9,5"/><Setter Property="FontSize" Value="12"/></Style>
  <!-- Menus like macOS: a dark frosted panel with rounded corners, blue highlight, check marks and submenu arrows, no icon column. -->
  <Style TargetType="ContextMenu"><Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="#F5F5F7"/><Setter Property="HasDropShadow" Value="False"/><Setter Property="OverridesDefaultStyle" Value="True"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu">
   <Border Background="#F2252527" BorderBrush="#40FFFFFF" BorderThickness="1" CornerRadius="10" Padding="5" Margin="0,0,14,14" MinWidth="190"><Border.Effect><DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.45"/></Border.Effect><StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/></Border>
  </ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="Separator"><Setter Property="OverridesDefaultStyle" Value="True"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator"><Border Height="1" Background="#26FFFFFF" Margin="8,4"/></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="MenuItem"><Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="#F5F5F7"/><Setter Property="OverridesDefaultStyle" Value="True"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
   <Border x:Name="B" Background="Transparent" CornerRadius="6" Padding="6,5,10,5"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Path x:Name="Check" Data="M0,4 L3.5,7.5 L10,0" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center" Visibility="Collapsed"/>
    <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="{TemplateBinding InputGestureText}" Opacity="0.55" Margin="24,0,0,0" VerticalAlignment="Center"/><Path x:Name="Arrow" Data="M0,0 L4,4 L0,8" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5" Margin="16,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/></StackPanel>
    <Popup x:Name="PART_Popup" Placement="Right" HorizontalOffset="8" VerticalOffset="-6" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
     <Border Background="#F2252527" BorderBrush="#40FFFFFF" BorderThickness="1" CornerRadius="10" Padding="5" Margin="0,0,14,14" MinWidth="170"><Border.Effect><DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.45"/></Border.Effect><StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/></Border>
    </Popup></Grid></Border>
   <ControlTemplate.Triggers>
    <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="B" Property="Background" Value="#0A84FF"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger>
    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Check" Property="Visibility" Value="Visible"/></Trigger>
    <Trigger Property="Role" Value="SubmenuHeader"><Setter TargetName="Arrow" Property="Visibility" Value="Visible"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ProgressBar"><Setter Property="Height" Value="4"/><Setter Property="Foreground" Value="#0A84FF"/><Setter Property="Background" Value="#3A3A3C"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar">
   <Grid><Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="2"/><Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="2" HorizontalAlignment="Left"/></Grid>
  </ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Mood" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Padding" Value="10,10"/><Setter Property="Margin" Value="0,0,8,8"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Background" Value="#2C2C2E"/></Style>
 </Window.Resources>
 <Grid Margin="40,32,40,28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,28"><TextBlock Text="Wallpaper &amp; theme" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="30" FontWeight="Bold"/><TextBlock Text="Pick a palette, choose light or dark, and apply. One-step undo, no admin." Foreground="#AEAEB2" Margin="0,6,0,0"/></StackPanel>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
   <StackPanel Margin="0,0,32,0">
    <Border CornerRadius="12" ClipToBounds="True" BorderBrush="#3A3A3C" BorderThickness="1"><Grid Height="290" x:Name="Preview"><Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#332B66" Offset="0"/><GradientStop Color="#101D38" Offset="1"/></LinearGradientBrush></Grid.Background>
     <Ellipse Width="360" Height="360" Fill="#14FFFFFF" HorizontalAlignment="Right" Margin="0,-150,-80,0" VerticalAlignment="Top"/>
     <Border x:Name="MockWindow" Width="300" Height="150" CornerRadius="10" Background="#E61C202B" VerticalAlignment="Center"><Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.25"/></Border.Effect><StackPanel Margin="20"><Grid><TextBlock x:Name="MockTitle" Text="Room to make it yours" FontWeight="SemiBold"/><TextBlock Text="−  □  ×" Foreground="#9CA6BA" HorizontalAlignment="Right" Margin="0,-18,0,0"/></Grid><Border Height="1" Background="#304F5670" Margin="0,14,0,14"/><TextBlock x:Name="MockBody" Text="Your space. Your palette." Foreground="#AAB5CB"/><StackPanel Orientation="Horizontal" Margin="0,16,0,0"><Border x:Name="MockAccent" Width="70" Height="20" CornerRadius="5" Background="#0A84FF"/><Border Width="110" Height="6" Background="#455069" CornerRadius="3" Margin="14,0,0,0"/></StackPanel></StackPanel></Border>
     <Border x:Name="MockTaskbar" VerticalAlignment="Bottom" Height="34" Background="#DD141821"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="⊞" FontSize="20" Foreground="#ADB6FF"/><TextBlock Text="   ⌕    ▣    ◉" Foreground="#C6CDDE" FontSize="16"/></StackPanel></Border>
     <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12" Padding="7,3" Background="#66000000" CornerRadius="4"><TextBlock Text="PREVIEW" FontSize="9" Foreground="White"/></Border>
    </Grid></Border>
    <Grid Margin="0,26,0,10"><TextBlock Text="Palette" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="PaletteLabel" Text="Dusk · #332B66 → #101D38" HorizontalAlignment="Right" Foreground="#8E8E93" FontSize="12" VerticalAlignment="Center"/></Grid>
    <UniformGrid Columns="4" Margin="0,0,-8,0">
     <Button x:Name="Dusk" Style="{StaticResource Mood}"><StackPanel Orientation="Horizontal"><Ellipse Width="16" Height="16" Margin="0,0,9,0"><Ellipse.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#332B66"/><GradientStop Color="#101D38" Offset="1"/></LinearGradientBrush></Ellipse.Fill></Ellipse><TextBlock Text="Dusk"/></StackPanel></Button>
     <Button x:Name="Ocean" Style="{StaticResource Mood}"><StackPanel Orientation="Horizontal"><Ellipse Width="16" Height="16" Margin="0,0,9,0"><Ellipse.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#184B63"/><GradientStop Color="#091F35" Offset="1"/></LinearGradientBrush></Ellipse.Fill></Ellipse><TextBlock Text="Ocean"/></StackPanel></Button>
     <Button x:Name="Forest" Style="{StaticResource Mood}"><StackPanel Orientation="Horizontal"><Ellipse Width="16" Height="16" Margin="0,0,9,0"><Ellipse.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#345C49"/><GradientStop Color="#102E31" Offset="1"/></LinearGradientBrush></Ellipse.Fill></Ellipse><TextBlock Text="Forest"/></StackPanel></Button>
     <Button x:Name="Daylight" Style="{StaticResource Mood}"><StackPanel Orientation="Horizontal"><Ellipse Width="16" Height="16" Margin="0,0,9,0"><Ellipse.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#F3CDA2"/><GradientStop Color="#ACBADB" Offset="1"/></LinearGradientBrush></Ellipse.Fill></Ellipse><TextBlock Text="Daylight"/></StackPanel></Button>
     <Button x:Name="Ember" Style="{StaticResource Mood}"><StackPanel Orientation="Horizontal"><Ellipse Width="16" Height="16" Margin="0,0,9,0"><Ellipse.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#7A3B2E"/><GradientStop Color="#1E1225" Offset="1"/></LinearGradientBrush></Ellipse.Fill></Ellipse><TextBlock Text="Ember"/></StackPanel></Button>
     <Button x:Name="Rose" Style="{StaticResource Mood}"><StackPanel Orientation="Horizontal"><Ellipse Width="16" Height="16" Margin="0,0,9,0"><Ellipse.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#7B3F66"/><GradientStop Color="#22183A" Offset="1"/></LinearGradientBrush></Ellipse.Fill></Ellipse><TextBlock Text="Rose"/></StackPanel></Button>
     <Button x:Name="Aurora" Style="{StaticResource Mood}"><StackPanel Orientation="Horizontal"><Ellipse Width="16" Height="16" Margin="0,0,9,0"><Ellipse.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#1F6B62"/><GradientStop Color="#1C1E4A" Offset="1"/></LinearGradientBrush></Ellipse.Fill></Ellipse><TextBlock Text="Aurora"/></StackPanel></Button>
     <Button x:Name="Graphite" Style="{StaticResource Mood}"><StackPanel Orientation="Horizontal"><Ellipse Width="16" Height="16" Margin="0,0,9,0"><Ellipse.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#3A3F4B"/><GradientStop Color="#121419" Offset="1"/></LinearGradientBrush></Ellipse.Fill></Ellipse><TextBlock Text="Graphite"/></StackPanel></Button>
    </UniformGrid>
    <Button x:Name="CustomColor" Content="Custom colors…" Style="{StaticResource Ghost}" HorizontalAlignment="Left" Margin="-12,4,0,0"/>
    <TextBlock Text="Want it animated? Try Live wallpaper in WinDotra." Foreground="#8E8E93" TextWrapping="Wrap" FontSize="12" Margin="0,10,0,0"/>
   </StackPanel>
   <Border Grid.Column="1" Background="#2C2C2E" CornerRadius="12" Padding="16,12,16,14" VerticalAlignment="Top"><StackPanel>
    <TextBlock Text="App appearance" Foreground="#AEAEB2" FontSize="13"/><ComboBox x:Name="AppMode"><ComboBoxItem Content="Dark"/><ComboBoxItem Content="Light"/></ComboBox>
    <TextBlock Text="Windows appearance" Foreground="#AEAEB2" FontSize="13"/><ComboBox x:Name="SystemMode"><ComboBoxItem Content="Dark"/><ComboBoxItem Content="Light"/></ComboBox>
    <Border Height="1" Background="#3A3A3C"/>
    <CheckBox x:Name="Transparency" Content="Transparency effects" Style="{StaticResource Switch}"/>
    <Border Height="1" Background="#3A3A3C"/>
    <CheckBox x:Name="Wallpaper" Content="Apply this wallpaper" IsChecked="True" Style="{StaticResource Switch}"/>
    <TextBlock Text="Colors affect the generated wallpaper, not the Windows accent color." TextWrapping="Wrap" FontSize="12" Foreground="#8E8E93" Margin="0,6,0,14"/>
    <Button x:Name="TaskbarSettings" Content="Taskbar settings ↗" Style="{StaticResource Ghost}" HorizontalAlignment="Left" Margin="-12,0,0,0"/>
    <Button x:Name="ColorSettings" Content="Windows accent color ↗" Style="{StaticResource Ghost}" HorizontalAlignment="Left" Margin="-12,0,0,0"/>
   </StackPanel></Border>
  </Grid>
